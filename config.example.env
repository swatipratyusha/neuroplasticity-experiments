# Copy to config.env (install.sh does this for you) and edit. Shell syntax,
# sourced by the shell instruments. Paths are absolute.

# Where scripts and collected data live. Must NOT be under ~/Documents,
# ~/Desktop or ~/Downloads: launchd agents cannot read those (macOS TCC).
NEURO_HOME="$HOME/Library/Application Support/neuroplasticity"

# --- passive sampler -------------------------------------------------------
SAMPLE_TRACK_DOCKER=1                              # count running containers (0 to skip)
SAMPLE_AGENT_PROC_MATCH="claude"                   # process-name substring -> agent_procs column
SAMPLE_TRANSCRIPT_DIR="$HOME/.claude/projects"     # scanned for recently-touched transcripts

# --- subjective probe ------------------------------------------------------
PROBE_DAILY_CAP=5          # real answers per day before the probe goes quiet
PROBE_FIRE_PCT=55          # % chance a scheduled slot actually fires
PROBE_MAX_DELAY_S=2400     # random in-hour delay, so timing stays unpredictable
PROBE_IDLE_SKIP_S=600      # skip if you have been away this long
PROBE_EVENING_HOUR=20      # from this hour, force a sample if none landed since 18:00
PROBE_TIMEOUT_S=300        # dialog gives up after this long
PROBE_QUESTION="focus 1-5 | threads in head | doing what | what broke focus (- if nothing)"
