<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.neuroplasticity.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__NEURO_HOME__/bin/digest.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>NEURO_HOME</key><string>__NEURO_HOME__</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>__DIGEST_HOUR__</integer><key>Minute</key><integer>__DIGEST_MINUTE__</integer></dict>
  <key>StandardErrorPath</key><string>__NEURO_HOME__/data/digest.err.log</string>
</dict>
</plist>
